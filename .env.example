# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coaching_dev
PG_POOL_MAX=10

# Initial institute owner bootstrap. Use unique development credentials only.
BOOTSTRAP_TENANT_NAME=Demo Coaching Institute
BOOTSTRAP_TENANT_SLUG=demo-coaching
BOOTSTRAP_ADMIN_NAME=Institute Owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.test
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-random-password

# Production cookies must be Secure. Use SameSite=None only when frontend/API
# are on separate sites and the deployment is configured for credentialed CORS.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
